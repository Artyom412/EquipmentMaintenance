<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentMaintenance.ViewModels"
             xmlns:models="using:EquipmentMaintenance.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentMaintenance.Views.StatementListView"
             x:DataType="vm:StatementListViewModel"
             d:DataContext="{d:DesignInstance Type=vm:StatementListViewModel}">

    <Grid RowDefinitions="Auto, Auto" RowSpacing="5" Margin="5">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, *" ColumnSpacing="5">
            <Button Grid.Column="0" Content="Добавить" Command="{Binding AddCommand}"/>
            <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="70 0">
                <TextBox PlaceholderText="Например Компьютер" MinWidth="250" Margin="0 0 5 0"/>
                <Button Content="Поиск"/>
            </StackPanel>
            <Button Grid.Column="3" Content="Удалить" Command="{Binding DeleteCommand}" HorizontalAlignment="Right"/>
        </Grid>

            <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedStatement}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Statement }">
                            <Border Width="200" Height="250" Margin="10" Padding="10" Background="#FDFDFD" BorderThickness="5"
                                    CornerRadius="8" BoxShadow="0 4 10 0 #20000000">
                                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="5">
                                    <!-- Заголовок карточки -->
                                    <TextBlock Grid.Row="0" 
                                               Text="{Binding Name}"/>

                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding CompletionDate}" 
                                               Margin="0,10,0,0"/>
                    
                                    <!-- Действие/Нижняя часть -->
                                    <Button Grid.Row="2" 
                                            Content="Открыть" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
    </Grid>
</UserControl>
