<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentMaintenance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentMaintenance.Views.OthersListView"
             x:DataType="vm:OthersListViewModel">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:OthersListViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto" Margin="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Наименование" Margin="0 0 5 0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Name}" MinWidth="270"/>
            <Button Content="Добавить должности" Margin="5 0" CommandParameter="JobTitle"
                    Command="{Binding AddRecordCommand}"/>
            <Button Content="Добавить места размещения" Margin="0 0 5 0" CommandParameter="Location"
                    Command="{Binding AddRecordCommand}"/>
            <Button Content="Добавить еденицы измерения" CommandParameter="Measure"
                    Command="{Binding AddRecordCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0 10">
            <GroupBox Grid.Column="0" Header="Должности">
                <TableView CanUserResizeColumns="False" ItemsSource="{Binding JobTitles}">
                    <TableView.Columns>
                        <TableViewColumn Header="Наименование" Binding="{Binding Name}"/>
                    </TableView.Columns>
                </TableView> 
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Места размещения">
                <TableView CanUserResizeColumns="False" ItemsSource="{Binding Locations}">
                    <TableView.Columns>
                        <TableViewColumn Header="Наименование" Binding="{Binding Name}"/>
                    </TableView.Columns>
                </TableView>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Еденицы измерения">
                <TableView CanUserResizeColumns="False" ItemsSource="{Binding Measurements}">
                    <TableView.Columns>
                        <TableViewColumn Header="Наименование" Binding="{Binding Name}"/>
                    </TableView.Columns>
                </TableView>
            </GroupBox>

        </Grid>

    </Grid>
</UserControl>