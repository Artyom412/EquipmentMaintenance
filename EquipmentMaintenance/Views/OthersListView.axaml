<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentMaintenance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentMaintenance.Views.OthersListView"
             x:DataType="vm:OthersListViewModel">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:OthersListViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto" Margin="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Наименование" Margin="0 0 5 0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Name}" MinWidth="270"/>
            <Button Content="Добавить должности" Margin="5 0" CommandParameter="JobTitle"
                    Command="{Binding AddRecordCommand}"/>
            <Button Content="Добавить места размещения" Margin="0 0 5 0" CommandParameter="Location"
                    Command="{Binding AddRecordCommand}"/>
            <Button Content="Добавить еденицы измерения" CommandParameter="Measure"
                    Command="{Binding AddRecordCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0 10">
            <Grid Grid.Column="0" RowDefinitions="*, Auto">
                <GroupBox Grid.Row="0" Header="Должности">
                    <TableView CanUserResizeColumns="False" ItemsSource="{Binding JobTitles}" SelectedItem="{Binding SelectedJobTitle}">
                        <TableView.Columns>
                            <TableViewColumn Header="Наименование" Binding="{Binding Name}"/>
                        </TableView.Columns>
                    </TableView> 
                </GroupBox>
                <StackPanel Grid.Row="1" Margin="10" Orientation="Horizontal" Spacing="10">
                    <Button Content="Удалить" Command="{Binding RemoveJobTitleCommand}"/>
                    <Button Content="Обновить" Command="{Binding UpdateJobTitleCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*, Auto">
                <GroupBox Grid.Row="0" Header="Места размещения">
                    <TableView CanUserResizeColumns="False" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}">
                        <TableView.Columns>
                            <TableViewColumn Header="Наименование" Binding="{Binding Name}"/>
                        </TableView.Columns>
                    </TableView>
                </GroupBox>
                <StackPanel Grid.Row="1" Margin="10" Orientation="Horizontal" Spacing="10">
                    <Button Content="Удалить" Command="{Binding RemoveLocationCommand}"/>
                    <Button Content="Обновить" Command="{Binding UpdateLocationCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="*, Auto">
                <GroupBox Grid.Row="0" Header="Еденицы измерения">
                    <TableView CanUserResizeColumns="False" ItemsSource="{Binding Measurements}" SelectedItem="{Binding SelectedMeasurement}">
                        <TableView.Columns>
                            <TableViewColumn Header="Наименование" Binding="{Binding Name}"/>
                        </TableView.Columns>
                    </TableView>
                </GroupBox>
                <StackPanel Grid.Row="1" Margin="10" Orientation="Horizontal" Spacing="10">
                    <Button Content="Удалить" Command="{Binding RemoveMeasurementCommand}"/>
                    <Button Content="Обновить" Command="{Binding UpdateMeasurementsCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>