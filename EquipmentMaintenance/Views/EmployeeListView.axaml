<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentMaintenance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentMaintenance.Views.EmployeeListView"
             x:DataType="vm:EmployeeListViewModel">
    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="5" Margin="5">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, *" ColumnSpacing="5">
            <Button Grid.Column="0" Content="Добавить" Command="{Binding AddCommand}"/>
            <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="70 0">
                <TextBox Text="{Binding SearchText}" PlaceholderText="Например Иванов" MinWidth="250" Margin="0 0 5 0"/>
                <Button Content="Поиск" Command="{Binding SearchCommand}"/>
            </StackPanel>
            <Button Grid.Column="3" Content="Удалить" Command="{Binding DeleteCommand}" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
        <TableView Grid.Row="2" CanUserResizeColumns="False" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEmployee}">
            <TableView.Columns>
                <TableViewColumn Header="ФИО" Binding="{Binding Name}"/>
                <TableViewColumn Header="Должность" Binding="{Binding JobTitle.Name}"/>
            </TableView.Columns>
        </TableView>
    </Grid>
</UserControl>
