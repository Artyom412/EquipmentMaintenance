<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentMaintenance.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="465" d:DesignHeight="230"
        x:Class="EquipmentMaintenance.Views.MaterialObjectView"
        x:DataType="vm:MaterialObjectViewModel"
        Title="Материал"
        Width="465" Height="230">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, Auto" 
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RowSpacing="10" ColumnSpacing="10" Margin="10">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Инвентарный номер" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ItemNumber}" PlaceholderText="Например И001" MinWidth="290"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" PlaceholderText="Реле" MinWidth="290"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Еденица измерения" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Measurements}" 
                  SelectedItem="{Binding SelectedMeasure}" 
                  DisplayMemberBinding="{Binding Name}" PlaceholderText="Выбирите из списка" MinWidth="290"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Норма расхода" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ConsumptionRate}" 
               Minimum="0" 
               Maximum="2000000" 
               Increment="1" 
               FormatString="0"/>

        <Button Grid.Row="4" Grid.Column="0" Content="Отменить" Command="{Binding CancelExecuteCommand}"/>
        <Button Grid.Row="4" Grid.Column="1" Content="Записать" Command="{Binding ConfirmExecuteCommand}" HorizontalAlignment="Right"/>

    </Grid>
</Window>
