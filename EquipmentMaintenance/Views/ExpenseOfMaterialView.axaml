<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentMaintenance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentMaintenance.Views.ExpenseOfMaterialView"
             x:DataType="vm:ExpenseOfMaterialViewModel">
    <Grid RowDefinitions="Auto, *" Margin="5">
        <TableView Grid.Row="1" ItemsSource="{Binding ExpenseOfMaterials}" CanUserResizeColumns="False">
            <TableView.Columns>
                <TableViewColumn  Header="Материал" Binding="{Binding MaterialName}"/>
                <TableViewColumn  Header="Расход" Binding="{Binding Expense}"/>
            </TableView.Columns>
        </TableView>
    </Grid>
</UserControl>
